if __name__ == "__main__":
    # Cost matrix representing distances between 4 cities
    # matrix[i][j] is the cost to travel from city i to city j
    graph = [
        [0, 10, 15, 20],
        [10, 0, 35, 25],
        [15, 35, 0, 30],
        [20, 25, 30, 0]
    ]

    print("The minimum travel cost is:", tsp(graph))
