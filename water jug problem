from collections import deque

def solve_water_jug(jug1_cap, jug2_cap, target):
    # Queue stores tuples of ((current_jug1, current_jug2), [path_of_states])
    queue = deque([((0, 0), [(0, 0)])])
    
    # Set to keep track of already visited states to avoid infinite loops
    visited = set([(0, 0)])
    
    while queue:
        (j1, j2), path = queue.popleft()
        
        # Check if either jug has reached the exact target volume
        if j1 == target or j2 == target:
            return path
            
        # Define all 6 possible rules/actions from the current state
        moves = [
            (jug1_cap, j2),     # 1. Fill Jug 1
            (j1, jug2_cap),     # 2. Fill Jug 2
            (0, j2),            # 3. Empty Jug 1
            (j1, 0),            # 4. Empty Jug 2
            # 5. Pour Jug 1 into Jug 2 until Jug 2 is full or Jug 1 is empty
            (j1 - min(j1, jug2_cap - j2), j2 + min(j1, jug2_cap - j2)),
            # 6. Pour Jug 2 into Jug 1 until Jug 1 is full or Jug 2 is empty
            (j1 + min(j2, jug1_cap - j1), j2 - min(j2, jug1_cap - j1))
        ]
        
        for next_state in moves:
            if next_state not in visited:
                visited.add(next_state)
                queue.append((next_state, path + [next_state]))
                
    return None

# --- Example Usage ---
if __name__ == "__main__":
    # Standard problem: Jug1 = 4L, Jug2 = 3L, Target = 2L
    j1_capacity = 4
    j2_capacity = 3
    target_amount = 2
    
    solution = solve_water_jug(j1_capacity, j2_capacity, target_amount)
    
    if solution:
        print(f"🎉 Shortest path found ({len(solution) - 1} steps):")
        for step, (j1, j2) in enumerate(solution):
            print(f"Step {step}: Jug1 = {j1}L, Jug2 = {j2}L")
    else:
        print("❌ No solution is possible for these capacities and target.")
