def solve_n_queens(n):
    """
    Solves the N-Queens problem and returns all valid board configurations.
    
    :param n: Size of the chessboard (N x N) and number of queens.
    :return: A list of lists, where each sublist represents a valid board layout.
    """
    solutions = []
    # Initialize the board with empty squares ('.')
    board = [["."] * n for _ in range(n)]

    # Sets to track threatened lines efficiently
    cols = set()
    pos_diag = set()  # (row + col)
    neg_diag = set()  # (row - col)

    def backtrack(row):
        # Base case: All queens are placed successfully
        if row == n:
            # Format the current board state as strings and add to solutions
            solutions.append([" ".join(r) for r in board])
            return

        for col in range(n):
            # Check if this square is under attack
            if col in cols or (row + col) in pos_diag or (row - col) in neg_diag:
                continue

            # Place the queen
            board[row][col] = "Q"
            cols.add(col)
            pos_diag.add(row + col)
            neg_diag.add(row - col)

            # Move to the next row
            backtrack(row + 1)

            # Backtrack: Remove the queen and try the next position
            board[row][col] = "."
            cols.remove(col)
            pos_diag.remove(row + col)
            neg_diag.remove(row - col)

    # Start the recursive solver from the first row
    backtrack(0)
    return solutions


# --- Example Usage for an 8x8 Chessboard ---
N = 8
all_solutions = solve_n_queens(N)

print(f"Total solutions found for N={N}: {len(all_solutions)}")
print("\nExample Solution Layout:\n")
for row in all_solutions[0]:
    print(row)
